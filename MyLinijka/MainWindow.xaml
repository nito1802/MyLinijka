<Window x:Class="MyLinijka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyLinijka"
        mc:Ignorable="d"
        Icon="Linijka.ico"
        Title="MainWindow" Height="300" Width="500"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize" AllowsTransparency="True"
        Background="#19000000"
        PreviewKeyDown="Window_PreviewKeyDown"
        ShowActivated="True" WindowStyle="None"  Loaded="Window_Loaded" Closing="Window_Closing">
    <!--Background="#19000000"-->

    <Window.Resources>
        <Style x:Key="HoverBorder" TargetType="Border">
            <Setter Property="Background" Value="#01FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B2FFFFFF" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BorderClicked" TargetType="Border">
            <Setter Property="Background" Value="#B2FFFFFF" />
        </Style>

        <Style x:Key="HoverBorderColorPickup" TargetType="Border">
            <Setter Property="Background" Value="#01FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B2D4D3D3" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShapeHoverBorder" TargetType="Border">
            <Setter Property="Background" Value="#01FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShapeBorderClicked" TargetType="Border">
            <Setter Property="Background" Value="#4CFFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridMouseOver" TargetType="Grid">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!--alpha: 0.4-->
    <Canvas Name="MainCanvas">
        <!--<Canvas.ContextMenu>
         <ContextMenu>
            <ContextMenu.ItemsSource>
               <CompositeCollection>
                  <MenuItem Header="Standard MenuItem 1" />
                  <MenuItem Header="Standard MenuItem 2" />
                  <MenuItem Header="Standard MenuItem 3" />
                  -->
        <!--<CollectionContainer Collection="{StaticResource extensions}" />-->
        <!--
               </CompositeCollection>
            </ContextMenu.ItemsSource>
         </ContextMenu>
      </Canvas.ContextMenu>-->
        
        <Grid Name="ToolbarGrid" Cursor="Hand" PreviewMouseRightButtonDown="ToolbarGrid_PreviewMouseRightButtonDown" Style="{StaticResource GridMouseOver}" Canvas.Left="200" Canvas.Top="0" Background="#99FFFFFF" Panel.ZIndex="10" >
            <!--Canvas.Left="1000" Canvas.Top="50"-->

            <Grid.RowDefinitions>
                <RowDefinition />
                <!--opis-->
                <RowDefinition />
                <!--linia-->
                <RowDefinition />
                <!--prostokąt-->
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <!--rysunki-->
                <ColumnDefinition />
                <!--fill-->
                <ColumnDefinition />
                <!--stroke-->
                <ColumnDefinition />
                <!--thickness-->
                <ColumnDefinition  Width="50"/>
                <!--stats-->
                <ColumnDefinition  Width="80"/>
                <!--stats Value-->
            </Grid.ColumnDefinitions>

            <Button Name="btnSwitch" Margin="2" Width="20" Grid.Column="0"  ToolTip="Switch" Background="#FF0E910E" Click="btnSwitch_Click" />
            <Button Margin="2" Width="20" Grid.Column="2" Content="D" Click="Button_Click" ToolTip="Delete All" Background="#FF2AAEC3"  />

            <Button Name="btnQuit" Grid.Row="0" Grid.Column="1" Margin="2" Width="20" Content="X" Click="btnQuit_Click" ToolTip="Quit" Background="#FFD49B9B" />
            <TextBlock Margin="10 0 0 0" Grid.Column="4" Text="Start" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Margin="10 0 0 0" Grid.Row="1" Grid.Column="4" Text="End" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="tbLengthStats" Margin="10 0 0 0" Grid.Row="2" Grid.Column="4" Text="Length" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="tbAngleStats" Margin="10 0 0 0" Grid.Row="3" Grid.Column="4" Text="Angle" FontWeight="Bold" VerticalAlignment="Center"/>

            <TextBox x:Name="tBoxStartStats" Margin="5 0 5 0" Grid.Column="5" Text="{Binding StatsDataContext.StartPoint}" VerticalAlignment="Center"/>
            <TextBox x:Name="tBoxEndStats" Margin="5 0 5 0" Grid.Row="1" Grid.Column="5" Text="{Binding StatsDataContext.EndPoint}" VerticalAlignment="Center"/>
            <TextBox x:Name="tBoxLengthStats" Margin="5 0 5 0" Grid.Row="2" Grid.Column="5" Text="{Binding StatsDataContext.LengthLine, StringFormat={}{0:N0}}" VerticalAlignment="Center"/>
            <TextBox x:Name="tBoxAngleStats" Margin="5 0 5 0" Grid.Row="3" Grid.Column="5" Text="{Binding StatsDataContext.Angle,StringFormat={}{0:N1}}" VerticalAlignment="Center"/>
            <TextBox x:Name="tBoxWidthStats" Margin="5 0 5 0" Grid.Row="2" Grid.Column="5" Visibility="Collapsed" Text="{Binding StatsDataContext.Width, StringFormat={}{0:N0}}" VerticalAlignment="Center"/>
            <TextBox x:Name="tBoxHeightStats" Margin="5 0 5 0" Grid.Row="3" Grid.Column="5" Visibility="Collapsed" Text="{Binding StatsDataContext.Height, StringFormat={}{0:N0}}" VerticalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="1" Content="F" HorizontalAlignment="Center" ToolTip="Fill" />
            <Label Grid.Row="1" Grid.Column="2" Content="S" HorizontalAlignment="Center" ToolTip="Stroke" />
            <Label Grid.Row="1" Grid.Column="3" Content="T" HorizontalAlignment="Center" ToolTip="Thickness" />

            <Border Name="LineBorder" Padding="2"  Grid.Row="2" Width="30" Style="{StaticResource ShapeBorderClicked}"  PreviewMouseLeftButtonDown="LineBorder_PreviewMouseLeftButtonDown">
                <Rectangle Width="15" Height="2" Fill="#FF2E2E2E" />
            </Border>
            <Border Name="RectBorder" Padding="2" Grid.Row="3" Width="30" Style="{StaticResource ShapeHoverBorder}" PreviewMouseLeftButtonDown="RectBorder_PreviewMouseLeftButtonDown" >
                <Rectangle Width="15" Height="10" Stroke="#FF2E2E2E"  />
            </Border>

            <Border Padding="2" Style="{StaticResource HoverBorder}" Grid.Row="2" Width="20" Grid.Column="1" PreviewMouseLeftButtonDown="Border_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="{Binding LineFill, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Left" Margin="3,5,0,5"  />
            </Border>

            <Border Padding="2" Style="{StaticResource HoverBorder}" Grid.Row="3" Grid.Column="1" PreviewMouseLeftButtonDown="Border_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="{Binding RectFill, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  />
            </Border>

            <Border Padding="2" Style="{StaticResource HoverBorder}" Width="20" Grid.Row="2" Grid.Column="2" PreviewMouseLeftButtonDown="Border_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="{Binding LineStroke, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  />
            </Border>

            <Border Padding="2" Style="{StaticResource HoverBorder}" Width="20" Grid.Row="3" Grid.Column="2" PreviewMouseLeftButtonDown="Border_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="{Binding RectStroke, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  />
            </Border>

            <Border Margin="2" Grid.Row="2" Grid.Column="3" Width="25">
                <TextBox Text="{Binding LineThickness, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" PreviewTextInput="TextBox_PreviewTextInput" />
            </Border>

            <Border Margin="2" Grid.Row="3" Grid.Column="3" Width="25">
                <TextBox Text="{Binding RectThickness, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" PreviewTextInput="TextBox_PreviewTextInput" />
            </Border>

        </Grid>

        <Grid Name="ChangeColorGrid" Canvas.Left="234" Canvas.Top="200" Background="#CC838282" Panel.ZIndex="11">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Name="ColorPickup" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown" >
                <!--Background="#B2D4D3D3"-->
                <Rectangle Width="10" Height="10" Fill="#FFD8D8D8"  />
            </Border>

            <Border Grid.Row="1" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FF666666"  />
            </Border>

            <Border Grid.Row="2" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="Black"  />
            </Border>



            <Border Grid.Column="1" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FF98BFF7"  />
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FF618DCD"  />
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FF2963B6"  />
            </Border>



            <Border Grid.Column="2" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FF3CD18D"  />
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FF11B86B"  />
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FF077643"  />
            </Border>



            <Border Grid.Column="3" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FFF77C81"  />
            </Border>

            <Border Grid.Row="1" Grid.Column="3" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FFF54D54"  />
            </Border>

            <Border Grid.Row="2" Grid.Column="3" Width="20" Height="20" Style="{StaticResource HoverBorderColorPickup}" PreviewMouseLeftButtonDown="ColorPickup_PreviewMouseLeftButtonDown">
                <Rectangle Width="10" Height="10" Fill="#FFE22830"  />
            </Border>
        </Grid>
        <!--<Rectangle Canvas.Left="300" Canvas.Top="300" Width="200" Height="100" Stroke="#FFEC4848" StrokeThickness="10" />-->
    </Canvas>
</Window>
